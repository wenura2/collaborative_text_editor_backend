# Backend Environment Configuration
# Copy this file to .env and fill in the actual values

# Server port (Render will set this automatically)
PORT=5000

# Frontend URL for CORS (update with your Netlify domain)
FRONTEND_URL=http://localhost:5173

# MongoDB Connection String
# Get this from MongoDB Atlas or your MongoDB provider
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority

# JWT Secret Keys (generate random strings)
ACCESS_TOKEN_SECRET_KEY=your_access_token_secret_key_here_generate_random_string
REFRESH_TOKEN_SECRET_KEY=your_refresh_token_secret_key_here_generate_random_string

# JWT Expiration times
JWT_EXPIRES=5m

# GitHub OAuth (optional, for GitHub integration)
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Node environment
NODE_ENV=production
